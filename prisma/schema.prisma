// prisma/schema.prisma
// Item Master fields: MOF stores M/F/O and SerDuration stores service minutes.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tbl_CustomerMaster {
  CusCode          String   @id @db.Char(10)
  RegTel           String   @db.Char(15)
  CusName          String   @db.VarChar(200)
  CusAdd           String   @default(" ") @db.VarChar(200)
  CusEmail         String   @default(" ") @db.VarChar(200)
  CreditCustomer   Boolean  @default(false)
  CreditLimit      Float    @default(0)
  UsedCredit       Float    @default(0)
  Rmks             String   @default(" ") @db.VarChar(400)
  LoyalCus         Boolean  @default(false)
  CreatedBy        String   @default("0") @db.VarChar(50)
  CreateDateTime   DateTime @default(now()) @db.DateTime(0)
  DisPre           Float    @default(0)
  Picture          Bytes?
  CusBehaviour     Int      @default(0)
  BlackList        Boolean  @default(false)
  BlackListRemarks String   @default(" ") @db.VarChar(500)
  MemberTypeID     String   @default("0") @db.Char(10)
  Enable           Boolean  @default(true)
  PSW              String   @default(" ") @db.VarChar(255)
  Gender           String?  @db.VarChar(50)

  @@map("tbl_customermaster")
}

