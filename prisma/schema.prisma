  BatchNo         String    @default("") @db.VarChar(50)
  CostPrice       Float     @default(0)
  RetailPrice     Float     @default(0)
  GRNQty          Float     @default(0)
  FreeQty         Float     @default(0)
  ItemValue       Float     @default(0)
  ExpDate         DateTime? @db.DateTime(0)
