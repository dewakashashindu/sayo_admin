model Tbl_GRNHeader {
  LocCode     String    @default("") @db.Char(10)
  GRNNO       String    @default("") @db.VarChar(15)
  GRNDate     DateTime  @db.DateTime(0)
  SupID       String    @default("") @db.Char(10)
  SupInvNo    String    @default("") @db.VarChar(20)
  GrossTotal  Float     @default(0)
  DisVal      Float     @default(0)
  Adjestment  Float     @default(0)
  NetTotal    Float     @default(0)
  UserID      String    @default("") @db.Char(10)
  Remarks     String    @default("") @db.VarChar(400)
  TxnDate     DateTime  @db.DateTime(0)
  SysSerialNo Float     @default(0)
  Confirmed   String    @default("N") @db.Char(1)
  ConUserID   String    @default("") @db.Char(10)
  ConDatetime DateTime? @db.DateTime(0)
  GRNTYPE     String    @default("GR") @db.Char(2)
  // which purchase order this receipt belongs to — ' ' for a DIRECT GRN.
  // scripts/add-po-grn-tables.sql has always had it; the model was missing it,
  // so a database created by `prisma db push` could not store a PO-backed GRN.
  PONO        String    @default(" ") @db.Char(10)

  details Tbl_GRNDetails[]

  @@id([LocCode, GRNNO])
  @@map("tbl_grnheader")
}

model Tbl_GRNDetails {
  LocCode         String    @default("") @db.Char(10)
