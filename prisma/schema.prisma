// ─────────────────────────────────────────────────────────────────────────
// Purchase Order / GRN            (scripts/add-po-grn-tables.sql)
// ---------------------------------------------------------------------
// Tables come from the legacy VB application. Two additions that make a
// legacy table usable from a web app are marked "added":
// · LineNo        — every table needs a key; it also lets the same item
// sit on two lines (the legacy screen allowed that)
// · UpdItemPrice  — the GRN may push its RetailPrice into tbl_itemmaster;
// the flag records whether the user asked for that
// ItemCode is CHAR(15) like every other item-code column in this project.
// ─────────────────────────────────────────────────────────────────────────
model Tbl_POHeader {
  LocCode     String    @default("") @db.Char(10)
  PONO        String    @default("") @db.Char(10)
  PODate      DateTime  @db.DateTime(0)
  DueDate     DateTime  @db.DateTime(0)
  SupID       String    @default("") @db.Char(10)
  NetTotal    Float     @default(0)
  UserID      String    @default("") @db.Char(10)
  Remarks     String    @default("") @db.VarChar(1500)
  DeliAdd     String    @default("") @db.VarChar(100)
  TxnDate     DateTime  @db.DateTime(0)
  SysSerialNo String    @default("") @db.Char(10)
  ConUserID   String    @default("") @db.Char(10)
  Confirmed   String    @default("N") @db.Char(1)
  ConDatetime DateTime? @db.DateTime(0)

  details Tbl_PODetails[]

  @@id([LocCode, PONO])
  @@map("tbl_poheader")
}

model Tbl_PODetails {
  LocCode        String @default("") @db.Char(10)
  PONo           String @default("") @db.Char(10)
  LineNo         Int    @default(0)
  ItemCode       String @default("") @db.Char(15)
  UnitID         String @default("") @db.Char(10)
  CostPrice      Float  @default(0)
  POQty          Float  @default(0)
  ItemValue      Float  @default(0)
  DirectPOConfNo String @default("") @db.Char(10)
  GRNQty         Float  @default(0)
  GRNNOs         String @default("") @db.VarChar(500)

  header Tbl_POHeader @relation(fields: [LocCode, PONo], references: [LocCode, PONO])

  @@id([LocCode, PONo, LineNo])
