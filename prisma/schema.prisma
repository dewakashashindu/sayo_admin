  updated_by       String   @default("admin") @db.VarChar(100)
}

model servicesconfig {
  id            Int      @id @default(1)
  hero_heading  String   @default("Tailored Treatments for Your Unique Glow") @db.VarChar(500)
  hero_subtitle String   @db.Text
  categories    Json
  price_list    Json
  updated_at    DateTime
  updated_by    String   @default("admin") @db.VarChar(100)
}

model siteconfig {
  id         Int      @id @default(autoincrement())
  configKey  String   @unique(map: "SiteConfig_configKey_key") @db.VarChar(50)
  configData Json
  updatedAt  DateTime @default(now())

  @@index([configKey], map: "SiteConfig_configKey_idx")
}

model tbl_feedback {
  id          Int      @id @default(autoincrement())
  cusName     String   @db.VarChar(200)
  cusEmail    String   @db.VarChar(200)
  cusLocation String   @db.VarChar(100)
  cusService  String   @db.VarChar(200)
  cusRating   Int      @default(0)
  cusComment  String   @db.Text
  cusConsent  Boolean  @default(false)
  isPublished Boolean  @default(false)
  submittedAt DateTime @default(now())

  @@index([cusEmail], map: "Tbl_Feedback_cusEmail_idx")
  @@index([cusLocation], map: "Tbl_Feedback_cusLocation_idx")
  @@index([cusRating], map: "Tbl_Feedback_cusRating_idx")
  @@index([isPublished], map: "Tbl_Feedback_isPublished_idx")
  @@index([submittedAt], map: "Tbl_Feedback_submittedAt_idx")
}

model tbl_otpstore {
  id        Int      @id @default(autoincrement())
  email     String   @unique(map: "Tbl_OtpStore_email_key") @db.VarChar(200)
  code      String   @db.VarChar(6)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email], map: "Tbl_OtpStore_email_idx")
}

model user {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique(map: "User_email_key")
  phone     String?
  createdAt DateTime @default(now())
}

model tbl_ItemDetail {
  LocCode    String   @db.Char(10)
  ItemCode   String   @db.Char(15)
  ExpiryDate DateTime @db.DateTime(0)
  ItemQty    Float    @default(0)

  @@id([LocCode, ItemCode, ExpiryDate])
  @@map("tbl_itemdetail")
}

model tbl_billdetail {
  LocCode       String @db.Char(10)
