}

model tbl_billheader {
  LocCode            String   @db.Char(10)
  BillNo             String   @db.Char(15)
  Txndate            DateTime @default(now()) @db.DateTime(0)
  Gross              Float    @default(0)
  DisPre             Float    @default(0)
  DisVal             Float    @default(0)
  ServiceCharge      Float    @default(0)
  OtherServiceCharge Float    @default(0)
  TotalTaxAmount     Float    @default(0)
  AdvAmount          Float    @default(0)
  NetTotal           Float    @default(0)
