  RETYN           Boolean   @default(false)
  RETQTY          Float     @default(0)
  RETVAL          Float     @default(0)
  PONO            String    @default("") @db.Char(10)
  UpdItemPrice    Boolean   @default(false)

  header Tbl_GRNHeader @relation(fields: [LocCode, GRNNo], references: [LocCode, GRNNO])

  @@id([LocCode, GRNNo, LineNo])
  @@map("tbl_grndetails")
}

// ─────────────────────────────────────────────────────────────────────────
// Tbl_TxnMovement — old stock ledger (VB6 frmStocks.StockAddition)
// Created from your MSSQL script, ported to MySQL for Sayo.
// One row per receipt/issue: PreQty + TxnQty = LastQty, AddDeduct '+'/'-'
// Written together with GRN confirm (same transaction) when we want to keep
// the old program's stock in sync.
// See scripts/create-Tbl_TxnMovement-mysql.sql
// ─────────────────────────────────────────────────────────────────────────
model Tbl_TxnMovement {
  LocCode           String   @db.Char(15)
  RowItemCode       String   @db.VarChar(20)
  TxnNo             String   @db.VarChar(20)
  TxnType           String   @db.VarChar(100)
  TxnDate           DateTime @default(now()) @db.DateTime(0)
  TxndateTime       DateTime @default(now()) @db.DateTime(0)
  PreQty            Float    @default(0)
  TxnQty            Float    @default(0)
  LastQty           Float    @default(0)
  UserId            String   @db.VarChar(20)
  SysSerialId       Float    @default(0)
  Remarks           String   @default("") @db.VarChar(200)
  AddDeduct         String   @db.Char(1)
  TXNDATETIMEMANUAL DateTime @db.DateTime(0)
  SourceItemCode    String   @default("0") @db.VarChar(200)

  @@id([LocCode, RowItemCode, TxnNo, TxnType, TxndateTime])
  @@index([LocCode, RowItemCode], map: "idx_TxnMovement_Loc_Item")
  @@index([TxnNo], map: "idx_TxnMovement_TxnNo")
  @@map("tbl_txnmovement")
}

