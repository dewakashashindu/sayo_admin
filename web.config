<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" />
    </handlers>
    <httpPlatform processPath="node"
                  arguments="server.js"
                  startupTimeLimit="120"
                  startupRetryCount="5"
                  requestTimeout="00:03:00"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node.log">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <!-- Put your NEW database password here (URL-encode special characters, e.g. @ = %40) -->
        <environmentVariable name="DATABASE_URL" value="mysql://acd689_sayo:YOUR_NEW_PASSWORD@mysql8001.site4now.net:3306/db_acd689_sayo" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>