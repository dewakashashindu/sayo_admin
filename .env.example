# ─────────────────────────────────────────────────────────────────────────────
#  SAYO Admin — environment template
#
#  Copy this file to  .env  next to it and fill in the real values:
#        cp .env.example .env        (Windows:  copy .env.example .env )
#
#  NEVER commit the real .env, and never paste its contents into a chat, an
#  e-mail or a support ticket. The .gitignore in this project already ignores it.
#  After changing anything here, restart the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Database (required) ───────────────────────────────────────────────────
#  ?connect_timeout=8 makes a wrong host/user fail in 8 seconds instead of
#  hanging the sign-in screen for 25.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE?connect_timeout=8"

# ── 2. Session signing secret (required) ─────────────────────────────────────
#  64 hex characters. Generate one with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#  Changing it signs everybody out (that is normal — it is the point of it).
AUTH_SECRET=""

#  How long one sign-in lasts, in hours (1–24, default 4).
# SESSION_HOURS=4

# ── 3. Access profiles (required for /settings/access-profiles) ──────────────
#  The key that enciphers the permission rows (FuncID / ACCESS). Any long
#  secret string. If it is missing, saving an access profile refuses with
#  "ACCESS_CIPHER_KEY is not set".
ACCESS_CIPHER_KEY=""

# ── 4. The hidden super administrator (only for scripts/create-superadmin.mjs)
#  Value that encrypts its phone/e-mail inside tbl_userdetails. Defaults to
#  AUTH_SECRET when it is empty — set it explicitly if you ever change
#  AUTH_SECRET, otherwise those two values become unreadable.
# SUPER_ADMIN_CONTACT_KEY=""
#
#  Optional overrides for the script (the script has its own defaults):
# SUPER_ADMIN_USER_ID=USR0000000
# SUPER_ADMIN_GROUP_ID=GRP0000000
# SUPER_ADMIN_LOGIN=sayosuperadmin
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_PHONE=
# SUPER_ADMIN_EMAIL=

# ── 5. SMS (Text.lk) — appointment messages and the sign-in codes ────────────
#  While these are empty nothing is sent, and the screen says so instead of
#  pretending the message went out.
TEXTLK_API_TOKEN=""
TEXTLK_SENDER_ID="SAYO"

# ── 6. E-mail (SMTP) — sign-in codes and password-reset codes ────────────────
#  If SMTP_HOST is empty, every mail step is refused with a clear message.
#  The super administrator's sign-in needs BOTH an SMS channel and e-mail, so
#  set all of these up before you rely on it.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SAYO Beauty <no-reply@yourdomain.lk>"

# ── 7. Uploads (Cloudinary) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── 8. Server / proxy (only change these when a proxy is in front) ───────────
#  npm start runs server.mjs, which measures the caller's address on the socket
#  and deletes any x-forwarded-for header the caller sent. Behind ONE reverse
#  proxy that runs on another machine, set:
# TRUST_PROXY=1
#  If the proxy forwards x-forwarded-for without appending the caller itself:
# SAYO_IP_SOCKET_ONLY=1
#
# PORT=3000
# TZ=Asia/Colombo
